@page "/categories"
@using BlazorClient.Services
@attribute [Authorize]
@implements IDisposable
@inject ListState<Category> Store
@inject ICatalogueApi Api
@inject NavigationManager Nav

@switch (Store.State)
{
    case ViewState.Loading:
        <StateCard Loading="true" Title="@L["LoadingCategories"]" Message="@L["TakesFewSeconds"]" />
        break;

    case ViewState.Error:
        <StateCard CssClass="error-state"
                   Icon="@Icons.Material.Filled.PriorityHigh"
                   Title="@L["ErrorLoadingCategories"]"
                   Message="@L["CheckInternetAndTryAgain"]"
                   ErrorKey="@Store.ErrorKey"
                   ErrorStatus="@Store.ErrorStatus"
                   ActionText="@L["TryAgain"]"
                   OnAction="Retry" />
        break;

    case ViewState.Empty:
        <StateCard CssClass="empty-state"
                   Icon="@Icons.Material.Filled.Category"
                   Title="@L["CategoriesYetEmpty"]"
                   Message="@L["CategoriesEmptyHint"]" />
        break;

    default:
        <div class="mb-6">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["CategoriesSubtitle"]</MudText>
            <MudText Typo="Typo.h4" Class="fw-bold" Style="color: #1E3A2B;">@L["CategoriesTitle"]</MudText>
        </div>

        <MudGrid>
            @foreach (var category in Store.Items)
            {
                <MudItem xs="12" sm="6" md="4" @key="category.Id">
                    <CategoryCard Category="category"
                                  IsSelected="@(_selectedId == category.Id)"
                                  OnSelected="Select" />
                </MudItem>
            }
        </MudGrid>
        break;
}

@code {
    private int? _selectedId;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        await Store.EnsureLoadedAsync(Api.GetCategoriesAsync);
    }

    private void OnStoreChanged() => _ = InvokeAsync(StateHasChanged);

    private Task Retry() => Store.ReloadAsync(Api.GetCategoriesAsync);

    private void Select(Category category)
    {
        _selectedId = category.Id;
        Nav.NavigateTo($"subscriptions?category={category.Id}");
    }

    public void Dispose() => Store.Changed -= OnStoreChanged;
}
