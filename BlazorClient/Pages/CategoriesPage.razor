@page "/categories"
@using BlazorClient.Services
@implements IDisposable
@inject ListState<Category> Store
@inject ICatalogueApi Api
@inject NavigationManager Nav

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" Class="mb-4">@L["CategoriesTitle"]</MudText>

    @switch (Store.State)
    {
        case ViewState.Loading:
            <div class="d-flex justify-center my-8">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            </div>
            break;

        case ViewState.Error:
            <div class="error-state">@L["ErrorLoadingCategories"]</div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="Retry">@L["TryAgain"]</MudButton>
            break;

        case ViewState.Empty:
            <div class="empty-state">@L["CategoriesYetEmpty"]</div>
            break;

        default:
            <MudGrid>
                @foreach (var category in Store.Items)
                {
                    <MudItem xs="12" sm="6" md="4" @key="category.Id">
                        <CategoryCard Category="category"
                                      IsSelected="@(_selectedId == category.Id)"
                                      OnSelected="Select" />
                    </MudItem>
                }
            </MudGrid>
            break;
    }
</MudContainer>

@code {
    private int? _selectedId;

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        await Store.EnsureLoadedAsync(Api.GetCategoriesAsync);
    }

    private void OnStoreChanged() => _ = InvokeAsync(StateHasChanged);

    private Task Retry() => Store.ReloadAsync(Api.GetCategoriesAsync);

    private void Select(Category category)
    {
        _selectedId = category.Id;
        Nav.NavigateTo("subscriptions");
    }

    public void Dispose() => Store.Changed -= OnStoreChanged;
}
