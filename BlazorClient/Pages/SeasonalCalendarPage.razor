@page "/"
@page "/calendar"
@using BlazorClient.Models
@using MudBlazor
@using Microsoft.Extensions.Localization
@using BlazorClient.Resources
@using System.Globalization
@using BlazorClient.Services
@attribute [Authorize]
@implements IDisposable
@inject ListState<SeasonalPrice> Store
@inject ICatalogueApi Api
@inject ILiveUpdates Live
@inject CurrentUserState User

@if (_products.Count > 0)
{
    <div class="mb-4" data-product-picker>
        <label for="product-select" class="mud-typography mud-typography-caption" style="color: #666; display: block;">@L["ProductLabel"]</label>
        <select id="product-select" class="app-select" value="@SelectedProductId" @onchange="OnProductChanged">
            @foreach (var product in _products)
            {
                <option value="@product.Id" @key="product.Id">@product.Name</option>
            }
        </select>
    </div>
}

@if (Store.State == ViewState.Loading)
{
    <!-- Завантаження -->
    <MudPaper Class="pa-12 text-center my-8" Style="border-radius: 16px; background-color: white;" Elevation="0">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4" />
        <MudText Typo="Typo.h6" Class="fw-bold">@L["LoadingPrices"]</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["TakesFewSeconds"]</MudText>
    </MudPaper>
}
else if (Store.State == ViewState.Error)
{
    <!-- Помилка -->
    <StateCard CssClass="error-state"
               Icon="@Icons.Material.Filled.PriorityHigh"
               Title="@L["FailedToLoadData"]"
               Message="@L["CheckInternetAndTryAgain"]"
               ErrorKey="@Store.ErrorKey"
               ErrorStatus="@Store.ErrorStatus"
               ActionText="@L["TryAgain"]"
               OnAction="Retry" />
}
else if (Store.State == ViewState.Empty)
{
    <!-- Порожня сторінка -->
    <MudPaper Class="pa-12 text-center my-8" Style="border-radius: 16px; background-color: white;" Elevation="0">
        <MudAvatar Style="background-color: #D1E2D9; color: #1E3A2B; width: 64px; height: 64px;" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Large" />
        </MudAvatar>
        <MudText Typo="Typo.h5" Class="fw-bold mb-2">@L["NothingSelectedYet"]</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">@L["ChooseProductForBestBuy"]</MudText>

        <div class="d-flex justify-center gap-2 flex-wrap mt-4">
            @foreach (var product in _products)
            {
                var productId = product.Id;
                <MudChip T="string" Style="border-radius: 16px;" OnClick="@(() => SelectProductAsync(productId))" @key="product.Id">@product.Name</MudChip>
            }
        </div>
    </MudPaper>
}
else
{
    var verdict = ComputeVerdict();
    <!-- Сторінка з даними -->
    <div class="mb-4">
        <MudText Typo="Typo.caption" Style="color: #666;">@L["Calendar"]</MudText>
        <MudText Typo="Typo.h4" Class="fw-bold" Style="color: #1E3A2B;">@Store.Items[0].Name</MudText>
        @if (Live.IsLive)
        {
            <span data-live="connected" class="mud-typography mud-typography-caption" style="color: #2D8A57;">● @L["LiveUpdates"]</span>
        }
    </div>

    <MudGrid>
        <!-- Графік / Гістограма -->
        <MudItem Xs="12" Md="8">
            <MudPaper Class="pa-6" Style="border-radius: 16px; background: white;" Elevation="0">
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-1">@L["PriceThroughoutYear"]</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-6 d-block">@L["PriceIndexNote"]</MudText>

                <div class="d-flex justify-space-between align-end mt-8" style="height: 180px; padding: 0 10px;">
                    @foreach (var m in MonthlyData())
                    {
                        <div class="d-flex flex-column align-center" style="width: 7%;" @key="m.Number">
                            <MudText Typo="Typo.caption" Class="mb-1" Style="font-size: 10px;">@m.Label</MudText>
                            <div style="width: 100%; height: @(m.Height)px; background-color: @m.Color; border-radius: 4px 4px 0 0;"></div>
                            <MudText Typo="Typo.caption" Class="mt-2" Style="font-size: 11px; color: #666;">@m.Name</MudText>
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>

        <!-- Вердикт та Віджет підписки -->
        <MudItem Xs="12" Md="4">
            <!-- Зелена картка з вердиктом -->
            <MudPaper Class="pa-6 mb-4" Style="border-radius: 16px; background-color: #1E3A2B; color: white;" Elevation="0">
                <MudText Typo="Typo.caption" Style="opacity: 0.8;">@L["VerdictForMonth", DateTime.Today.ToString("MMMM yyyy", CultureInfo.CurrentUICulture)]</MudText>
                <MudText Typo="Typo.h5" Class="fw-bold mb-2" data-verdict="@verdict.Kind">@VerdictTitle(verdict)</MudText>
                <MudText Typo="Typo.body2" Style="opacity: 0.9;" Class="mb-4">@L[verdict.TextKey, verdict.Args]</MudText>

                <div class="d-flex gap-2">
                    <MudChip T="string" Size="Size.Small" Style="@ChipStyle(verdict, "Buy")">@L["BuyNow"]</MudChip>
                    <MudChip T="string" Size="Size.Small" Style="@ChipStyle(verdict, "Wait")">@L["Wait"]</MudChip>
                    <MudChip T="string" Size="Size.Small" Style="@ChipStyle(verdict, "Avoid")">@L["Avoid"]</MudChip>
                </div>
            </MudPaper>

            <!-- Біла картка форма сповіщення -->
            <MudPaper Class="pa-6" Style="border-radius: 16px; background-color: white;" Elevation="0">
                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1">@L["PriceNotifications"]</MudText>
                <MudTextField T="string" @bind-Value="_email" Immediate="true" Label="@L["EmailLabel"]" Variant="Variant.Outlined" Class="mb-3" Margin="Margin.Dense" Style="background-color: #F8F9FA;" />

                @if (_messageKey is string messageKey)
                {
                    <MudAlert Severity="@(_messageIsError ? Severity.Error : Severity.Success)" Class="mb-3">@L[messageKey]</MudAlert>
                }

                <MudButton id="calendar-subscribe" Variant="Variant.Filled" Disabled="@_subscribing" OnClick="SubscribeAsync" Style="background-color: #1E3A2B; color: white; border-radius: 20px; text-transform: none;" FullWidth="true">
                    @L["Subscribe"]
                </MudButton>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    private static readonly string[] MonthKeys =
        { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };

    private const string CurrentColor = "#1E3A2B";
    private const string CheapestColor = "#2D8A57";
    private const string DefaultColor = "#C8D6CE";

    private record MonthBar(int Number, string Name, string Label, int Height, string Color);

    /// <summary>12 стовпчиків за цінами із сервера: висота пропорційна ціні, найдешевший місяць підсвічено, поточний — темний.</summary>
    private List<MonthBar> MonthlyData()
    {
        var byMonth = Store.Items
            .Where(i => i.MonthNumber is >= 1 and <= 12)
            .GroupBy(i => i.MonthNumber)
            .ToDictionary(g => g.Key, g => g.First());
        var max = byMonth.Count == 0 ? 0m : byMonth.Values.Max(i => i.Price);
        var min = byMonth.Count == 0 ? 0m : byMonth.Values.Min(i => i.Price);
        var current = DateTime.Today.Month;

        return Enumerable.Range(1, 12).Select(number =>
        {
            var name = L["Month_" + MonthKeys[number - 1]].Value;
            if (!byMonth.TryGetValue(number, out var item) || max <= 0)
            {
                return new MonthBar(number, name, "—", 0, DefaultColor);
            }

            var height = (int)Math.Round((double)(item.Price / max) * 150);
            var color = number == current ? CurrentColor : item.Price == min ? CheapestColor : DefaultColor;
            return new MonthBar(number, name, item.Price.ToString("0", CultureInfo.CurrentCulture), height, color);
        }).ToList();
    }

    private int? _productId;
    private List<ProductOption> _products = new();
    private string _email = string.Empty;
    private string? _messageKey;
    private bool _messageIsError;
    private bool _subscribing;

    private sealed record Verdict(string Kind, string TextKey, object[] Args);

    /// <summary>Обраний товар: явний вибір користувача, інакше той, чиї ціни завантажено, інакше перший зі списку.</summary>
    private int SelectedProductId =>
        _productId
        ?? (Store.Items.Count > 0 && Store.Items[0].ProductId > 0 ? Store.Items[0].ProductId : (_products.Count > 0 ? _products[0].Id : 0));

    /// <summary>Категорія показаного товару: за нею підписуємося на групу SignalR і на сповіщення.</summary>
    private int CurrentCategoryId =>
        _products.FirstOrDefault(p => p.Id == SelectedProductId)?.CategoryId
        ?? Store.Items.FirstOrDefault()?.CategoryId
        ?? 0;

    private Task<IEnumerable<SeasonalPrice>> LoadPrices() =>
        _productId is int id ? Api.GetCalendarAsync(id) : Api.GetCalendarAsync();

    /// <summary>Порада за реальними цінами показаного товару (логіка спільна з екраном підписок).</summary>
    private Verdict ComputeVerdict()
    {
        var prices = Store.Items
            .Where(i => i.MonthNumber is >= 1 and <= 12)
            .GroupBy(i => i.MonthNumber)
            .ToDictionary(g => g.Key, g => g.First().Price);
        var advice = PriceAdvisor.Advise(prices, DateTime.Today.Month);

        object[] args = advice.Kind switch
        {
            AdviceKind.Wait => new object[] { L["Month_" + MonthKeys[advice.Month!.Value - 1]].Value, advice.Percent },
            AdviceKind.Buy or AdviceKind.Avoid when advice.TextKey != "VerdictStableText" => new object[] { advice.Percent },
            _ => Array.Empty<object>()
        };
        return new Verdict(advice.Kind.ToString(), advice.TextKey, args);
    }

    private string VerdictTitle(Verdict verdict) => verdict.Kind switch
    {
        "Buy" => L["BuyNow"].Value,
        "Wait" => L["Wait"].Value,
        "Avoid" => L["Avoid"].Value,
        _ => "—"
    };

    private static string ChipStyle(Verdict verdict, string kind) => verdict.Kind == kind
        ? "background-color: #2D5A3F; color: white;"
        : "background-color: rgba(255,255,255,0.15); color: white;";

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        Live.StateChanged += OnStoreChanged;
        Live.PriceChanged += OnPriceChanged;
        Live.CatalogueChanged += OnCatalogueChanged;
        await Store.EnsureLoadedAsync(LoadPrices);
        await JoinLiveAsync();
        await LoadProductsAndEmailAsync();
    }

    private async Task LoadProductsAsync()
    {
        try
        {
            _products = (await Api.GetProductsAsync()).ToList();
        }
        catch (Exception)
        {
            // the picker is optional: the calendar already shows the first product
            _products = new List<ProductOption>();
        }
    }

    private async Task LoadProductsAndEmailAsync()
    {
        await LoadProductsAsync();

        var user = await User.GetAsync();
        if (string.IsNullOrWhiteSpace(_email) && !string.IsNullOrWhiteSpace(user?.Email))
        {
            _email = user.Email;
        }
    }

    private async Task OnProductChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            await SelectProductAsync(id);
        }
    }

    private async Task SelectProductAsync(int productId)
    {
        _productId = productId;
        _messageKey = null;
        await Store.ReloadAsync(LoadPrices);
        await JoinLiveAsync();
    }

    /// <summary>Підписка на сповіщення про категорію показаного товару з поштою, яку вказав користувач.</summary>
    private async Task SubscribeAsync()
    {
        _messageKey = null;
        _messageIsError = true;

        var email = _email.Trim();
        if (email.Length == 0 || !new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(email))
        {
            _messageKey = "EmailInvalid";
            return;
        }

        var categoryId = CurrentCategoryId;
        if (categoryId <= 0)
        {
            _messageKey = "ErrorCategoryNotFound";
            return;
        }

        _subscribing = true;
        try
        {
            var result = await Api.SubscribeToCategoryAsync(categoryId, email);
            _messageIsError = !result.Succeeded;
            _messageKey = result.Succeeded ? "SubscribedToCategory" : result.ErrorKey;
        }
        finally
        {
            _subscribing = false;
        }
    }

    /// <summary>Підписка на групу категорії показаного товару: лише її зміни приходять на цю сторінку.</summary>
    private async Task JoinLiveAsync()
    {
        var categoryId = CurrentCategoryId;
        if (categoryId <= 0)
        {
            return;
        }

        try
        {
            await Live.JoinCategoryAsync(categoryId);
        }
        catch (Exception)
        {
            // «наживо» необов'язкове: дані вже показано
        }
    }

    /// <summary>Сервер повідомив про зміну: тихо перечитуємо ціни, сторінка не перезавантажується і не показує спінер.</summary>
    private void OnPriceChanged(PriceChanged change) => _ = InvokeAsync(async () =>
    {
        await Store.RefreshAsync(LoadPrices);
        await JoinLiveAsync();
    });

    private void OnStoreChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task Retry()
    {
        await Store.ReloadAsync(LoadPrices);
        await JoinLiveAsync();
    }

    /// <summary>
    /// Товар чи категорія змінилися в групі, до якої ми приєднані: оновлюємо список у вибірці, а якщо йдеться про показаний товар —
    /// і його ціни. Якщо показаний товар видалили, переходимо до першого наявного.
    /// </summary>
    private void OnCatalogueChanged(CatalogueChanged change) => _ = InvokeAsync(async () =>
    {
        if (change.CategoryId != CurrentCategoryId)
        {
            return;
        }

        await LoadProductsAsync();

        if (change.Entity == "Product" && change.ProductId == SelectedProductId)
        {
            if (change.Kind == "Deleted")
            {
                _productId = null;
            }

            await Store.RefreshAsync(LoadPrices);
            await JoinLiveAsync();
        }

        StateHasChanged();
    });

    public void Dispose()
    {
        Store.Changed -= OnStoreChanged;
        Live.StateChanged -= OnStoreChanged;
        Live.PriceChanged -= OnPriceChanged;
        Live.CatalogueChanged -= OnCatalogueChanged;
    }
}
