@page "/subscriptions"
@using BlazorClient.Models

<MudText Typo="Typo.h4" Class="mb-4">Управління абонементами</MudText>

@if (IsLoading)
{
    <div class="d-flex justify-center my-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (HasError)
{
    <div class="error-state">Помилка завантаження абонементів</div>
}
else if (Subscriptions == null || !Subscriptions.Any())
{
    <div class="empty-state">Абонементи відсутні</div>
}
else
{
    <div class="subscriptions-list">
        @foreach (var sub in Subscriptions)
        {
            <div class="subscription-item mb-4 p-4 border rounded">
                <MudText Typo="Typo.h6">@sub.Title</MudText>
                <MudText Typo="Typo.body2">Категорія: @sub.CategoryName</MudText>
                <MudText Typo="Typo.body1"><b>@sub.Price грн</b> / @sub.Duration</MudText>
                <MudChip T="string" Color="@(sub.IsActive? Color.Success: Color.Default)" Size="Size.Small">
                    @(sub.IsActive ? "Активний" : "Неактивний")
                </MudChip>
            </div>
        }
    </div>
}

@code {
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public bool HasError { get; set; } = false;
    [Parameter] public List<Subscription> Subscriptions { get; set; } = new();
}