@page "/subscriptions"
@implements IDisposable
@inject SubscriptionState State

<div class="mb-6">
    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["SubscriptionsCount", State.Items.Count]</MudText>
    <MudText Typo="Typo.h4" Class="fw-bold" Style="color: #1E3A2B;">@L["MySubscriptions"]</MudText>
</div>

@if (IsLoading)
{
    <MudPaper Class="pa-12 text-center my-4 loading-state" Style="border-radius: 16px; background-color: white;" Elevation="0">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4" />
        <MudText Typo="Typo.h6" Class="fw-bold">@L["LoadingSubscriptions"]</MudText>
    </MudPaper>
}
else if (HasError)
{
    <MudPaper Class="pa-12 text-center my-4 error-state" Style="border-radius: 16px; background-color: white;" Elevation="0">
        <MudAvatar Style="background-color: #D1E2D9; color: #1E3A2B; width: 64px; height: 64px;" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" Size="Size.Large" />
        </MudAvatar>
        <MudText Typo="Typo.h5" Class="fw-bold mb-2">@L["ErrorLoading"]</MudText>
        <MudButton Variant="Variant.Filled"
                   Class="mt-4 retry-button"
                   Style="background-color: #1E3A2B; color: white; border-radius: 20px;"
                   OnClick="Retry">
            @L["TryAgain"]
        </MudButton>
    </MudPaper>
}
else
{
    <MudGrid>
        <MudItem Xs="12" Md="8">
            <MudPaper Class="pa-6" Style="border-radius: 16px; background-color: white;" Elevation="0">
                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-1">@L["PriceNotifications"]</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-4 d-block">@L["NotifyWhenIndexBelowThreshold"]</MudText>

                @if (State.Items.Count == 0)
                {
                    <div class="empty-state text-center pa-6">
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">@L["SubscriptionsEmpty"]</MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["SubscriptionsEmptyHint"]</MudText>
                    </div>
                }
                else
                {
                    <div class="subscription-list">
                        @foreach (var item in State.Items)
                        {
                            <SubscriptionRow @key="item.Id" Item="item" OnRemove="Remove" />
                        }
                    </div>
                }
            </MudPaper>
        </MudItem>

        <MudItem Xs="12" Md="4">
            <MudPaper Class="pa-6" Style="border-radius: 16px; background-color: white;" Elevation="0">
                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">@L["WhereToSendNotifications"]</MudText>
                <SubscribeFormComponent OnSubmitted="OnSubscribed" />
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public bool HasError { get; set; } = false;
    [Parameter] public EventCallback OnRetry { get; set; }

    protected override void OnInitialized() => State.Changed += HandleStateChanged;

    // Подія може прийти не з потоку рендерингу, тому InvokeAsync
    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    private Task Retry() => OnRetry.InvokeAsync();

    private void Remove(int id) => State.Remove(id);

    private void OnSubscribed(SubscribeFormModel m) => State.Add(m.Email, m.Category, m.Threshold);

    public void Dispose() => State.Changed -= HandleStateChanged;
}
