@page "/admin"
@attribute [Authorize]

<RoleGate Role="Admin">
    <div class="mb-6">
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["AdminSubtitle"]</MudText>
        <MudText Typo="Typo.h4" Class="fw-bold" Style="color: #1E3A2B;">@L["AdminTitle"]</MudText>
    </div>

    <div class="admin-tabs mb-4">
        <button type="button" class="@TabClass("categories")" data-tab="categories" @onclick='() => _tab = "categories"'>@L["AdminTabCategories"]</button>
        <button type="button" class="@TabClass("products")" data-tab="products" @onclick='() => _tab = "products"'>@L["AdminTabProducts"]</button>
        <button type="button" class="@TabClass("prices")" data-tab="prices" @onclick='() => _tab = "prices"'>@L["AdminTabPrices"]</button>
    </div>

    @switch (_tab)
    {
        case "products":
            <AdminProductsPanel />
            break;
        case "prices":
            <AdminPricesPanel />
            break;
        default:
            <AdminCategoriesPanel />
            break;
    }
</RoleGate>

@code {
    private string _tab = "categories";

    private string TabClass(string tab) => _tab == tab ? "admin-tab active" : "admin-tab";
}
