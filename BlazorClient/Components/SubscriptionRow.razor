@using System.Globalization

<div class="d-flex justify-space-between align-center w-100 py-3">
    <div>
        <MudText Typo="Typo.subtitle2" Class="fw-bold">@Subscription.CategoryName</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">
            @if (Subscription.Threshold is decimal threshold)
            {
                @L["ThresholdLine", Subscription.Email, threshold.ToString(CultureInfo.CurrentCulture)]
            }
            else
            {
                @Subscription.Email
            }
        </MudText>
    </div>
    <div class="d-flex align-center gap-2">
        <MudChip T="string" Size="Size.Small" Style="background-color: #E2E8F0;">
            @(Subscription.IsActive ? L["FilterActive"] : L["FilterPaused"])
        </MudChip>
        <MudSwitch T="bool" Value="Subscription.IsActive" ValueChanged="Toggled" Color="Color.Success" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Subscription Subscription { get; set; } = default!;

    /// <summary>Викликається, коли користувач вмикає чи вимикає підписку.</summary>
    [Parameter] public EventCallback<Subscription> OnToggled { get; set; }

    private Task Toggled(bool isActive)
    {
        Subscription.IsActive = isActive;
        return OnToggled.InvokeAsync(Subscription);
    }
}
